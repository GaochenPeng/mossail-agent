# 模型认证：api_key 或 chatgpt；不要提交密钥或 OAuth 凭证。
AGENT_AUTH_MODE=api_key
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=

# chatgpt 模式先运行 scripts/chatgpt_login.py login，再用 models 查看可用模型。
# 该模式固定直连官方 API，不使用 OPENAI_API_KEY、OPENAI_BASE_URL。
CHATGPT_AUTH_DIR=.data/chatgpt
CHATGPT_ACCOUNT=default

# DeepSearch 网页场景；同一 Serper 账号提供检索和正文读取。
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
SERPER_SCRAPE_URL=https://scrape.serper.dev

# 单进程本地服务：前端、HTTP API 和 WebSocket 共用端口。
MOSSAIL_PORT=8010

# PG 和 Redis 为必选。填入应用账号连接串，不使用管理员或其他项目实例。
# 本机已准备环境可由 scripts/dev.py 读取
# .data/agent-workspace/environment/.env.private，不用复制密钥到本文件。
MOSSAIL_DATABASE_URL=postgresql://mossail:CHANGE_ME@127.0.0.1:15432/mossail_dev
MOSSAIL_DATABASE_SCHEMA=mossail
MOSSAIL_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:16379/0
MOSSAIL_REDIS_NAMESPACE=mossail:dev

# 每轮 Harness 执行超时（秒）；超时收尾为 failed，不自动重跑。
MOSSAIL_TASK_TIMEOUT=300
